generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReminderType {
  NONE
  EMAIL
  WHATSAPP
  BOTH
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  phone              String?
  role               Role                 @default(CLIENT)
  createdAt          DateTime             @default(now())
  professional       ProfessionalProfile?
  clientAppointments Appointment[]        @relation("ClientAppointments")
}

model ProfessionalProfile {
  id           String         @id @default(cuid())
  userId       String         @unique
  businessName String
  category     String
  description  String?
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  availability Availability[]
  appointments Appointment[]  @relation("ProfessionalAppointments")
}

model Service {
  id             String              @id @default(cuid())
  professionalId String
  name           String
  description    String?
  duration       Int // minutos
  price          Float // TODO (Sebas): pasar a Decimal o Int en centavos
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
}

model Availability {
  id             String              @id @default(cuid())
  professionalId String
  dayOfWeek      Int // 0 = domingo ... 6 = sábado
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Appointment {
  id             String              @id @default(cuid())
  professionalId String
  clientId       String
  serviceId      String
  // Día del turno. Se guarda a las 12:00 UTC para que se vea el mismo día
  // en cualquier huso horario de Argentina (ver src/lib/time.ts).
  date           DateTime
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  notes          String?
  status         AppointmentStatus   @default(PENDING)
  reminder       ReminderType        @default(NONE)
  professional   ProfessionalProfile @relation("ProfessionalAppointments", fields: [professionalId], references: [id], onDelete: Cascade)
  client         User                @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  service        Service             @relation(fields: [serviceId], references: [id])
  createdAt      DateTime            @default(now())

  @@index([professionalId, date])
  @@index([clientId])
}
