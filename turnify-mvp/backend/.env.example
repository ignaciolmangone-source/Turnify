# Copiá este archivo a backend/.env (el start-windows.bat lo hace solo)

# Coincide con docker-compose.yml
DATABASE_URL="postgresql://turnify:turnify@localhost:5432/turnify?schema=public"

# Clave para firmar los tokens. En producción usar una larga y aleatoria.
JWT_SECRET="cambiar-esta-clave-por-una-larga-y-secreta"

PORT=4000

# Desde dónde se permite llamar a la API (el front de Vite). Varios separados por coma.
CORS_ORIGIN="http://localhost:5173"

# Zona horaria del negocio, para saber qué turnos ya pasaron
APP_TIMEZONE="America/Argentina/Buenos_Aires"
